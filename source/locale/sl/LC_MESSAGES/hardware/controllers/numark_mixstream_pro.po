#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "Press this button to cycle between the Track Selection and Playlists."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:149
msgid "6"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:150
msgid "View"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press this button to cycle between maximized library view and the main UI."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:154
msgid "7"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:155
msgid "Lighting"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
