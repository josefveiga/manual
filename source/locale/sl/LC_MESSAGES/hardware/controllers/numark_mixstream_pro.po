msgid "8"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:160
msgid "Control Center"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press this button to activate Aux 1 for [Spotify in the "
"MIXXX](https://audministrator.wordpress.com/2023/02/21/mixxx-spotify-in-the-"
"mixxx/)."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:164
msgid "9"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:165
msgid "Shift"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press and hold this button to access secondary functions of other controls."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:169
msgid "10"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:170
msgid "Channel Level"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Turn this knob to adjust the level of the pre-fader, pre-EQ audio signal for"
" the channel."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:174
msgid "11"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:175
msgid "Channel EQ"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Turn these knobs to boost or cut the high, mid-range, and low frequencies "
"for the channel."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:179
msgid "12"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:180
msgid "Filter"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Adjusts the amount of the filter effect. Starting from the center (12:00) "
"position, turn counterclockwise to apply a low-pass filter, or turn "
"clockwise to apply a high-pass filter."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:184
msgid "13"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:185
msgid "FX Select"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press these buttons to enable or disable the selected effect: Echo, Delay, "
"Flanger or Phaser."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:189
msgid "14"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:190
msgid "Effects Toggle"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Move this toggle switch away from you to activate the selected effect—the "
"toggle will latch to that position. Pull the toggle back to the center "
"position to deactivate the effects."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Pull and hold this toggle toward you to activate the selected effect "
"momentarily, and release the toggle to deactivate the effect—the toggle will"
" return to the center position."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:195
msgid "15"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:196
msgid "Channel Fader"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "Use this fader to adjust the channel's volume level."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:200
msgid "16"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:201
msgid "Crossfader"
msgstr "Navzkrižni drsnik"

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "Use the crossfader to mix between Deck 1 and Deck 2."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:205
msgid "17"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:206
msgid "Main Level Meters"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"These LEDs display the audio signal level of the main mix (sent out of the "
"Main Outputs)."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:210
msgid "18"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:211
msgid "Headphone Preview"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "Press this button to preview the channel in the headphones."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Use the Headphone Mix knob to adjust the mix between the channel's pre-fader"
" signal and the headphones' cue channel."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:216
msgid "19"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:217
msgid "Headphone Mix"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Turn this knob to adjust the blend of the headphone cue and main channels "
"together in the headphones."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:221
msgid "20"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:222
msgid "Headphone Volume"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "Adjusts the volume for headphone cueing."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:226
msgid "21"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:227
msgid "Platter"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"This capacitive, touch-sensitive platter controls the audio playhead when "
"the wheel is touched and moved. See settings above for adjustments."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:231
msgid "22"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:232
msgid "Scratch Mode"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"When this button is enabled, Smart Scratch mode will be active. In this "
"mode, the track's timeline continues (the lower half of the waveform in the "
"display will continue moving forward) when you use the platter to "
"\"scratch\" the track. When you release the platter, the track will resume "
"normal playback from where it would have been if you had never moved the "
"platter."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"{hwlabel}`SHIFT` + **Press:** enable or disable jog mode. In this mode, "
"touch the platter and move it to temporarily adjust the track's speed."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press this button again to disable Smart Scratch and enable vinyl mode for "
"the platter. You can use the platter to \"scratch\" the track as you would "
"with a vinyl record."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:238
msgid "23"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:239
msgid "Sync / Sync Off"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "Hold this button to activate or deactivate sync."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:243
msgid "24"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:244
msgid "Cue / Previous"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"When the Deck is paused, you can set a Temporary Cue Point by moving the "
"platter to place the playhead at the desired location and then pressing the "
"Cue Button."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"During playback, you can press the Cue Button to return the track to this "
"Temporary Cue Point. (If you did not set a Temporary Cue Point, then it will"
" return to the beginning of the track.)"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"**Hold:** play the track from the Temporary Cue Point. Releasing the Cue "
"Button will return the track to the Temporary Cue Point and pause it. To "
"continue playback without returning to the Temporary Cue Point, press and "
"hold the Cue Button, then press and hold the Play Button, and then release "
"both buttons."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "{hwlabel}`SHIFT` + **Press:** return to the beginning of the track."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:251
msgid "25"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:252
msgid "Play/Pause"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "Press this button to pause or resume playback."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"{hwlabel}`SHIFT` + **Press:** \"stutter-play\" the track from the initial "
"cue point."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:257
msgid "26"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:258
msgid "Pitch Fader"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "Move this fader to adjust the speed (pitch) of the track."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:262
msgid "27"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:263
msgid "Pitch Bend –/+"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press and hold one of these buttons to momentarily reduce or increase "
"(respectively) the speed of the track."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "{hwlabel}`SHIFT` + **Press:** set the range of the pitch fader."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:268
msgid "28"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:269
msgid "Performance Pads"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"These pads have different functions on each deck depending on the current "
"pad mode. See Pad Modes for more information."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:273
msgid "29"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:274
msgid "Cue"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press this button to enter Cue mode. Press the button again to enter a "
"second bank of cues. To assign a cue to a pad, press a pad at the desired "
"location in the track."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "{hwlabel}`SHIFT` + **Pad:** clear a cue from a pad."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "{hwlabel}`SHIFT` + **Cue:** enter Stems Mode."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:280
msgid "30"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:281
msgid "Saved Loop"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press this button to enter Saved Loop mode. Press the button again to enter "
"a second bank of saved loops."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"To assign a loop to a pad and activate it, press a pad to create a Loop In "
"point at the current location, and then press it again to create the Loop "
"Out point at another location."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "To deactivate or reactivate a loop, press the corresponding pad."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "{hwlabel}`SHIFT` + **Pad:** delete a loop from a pad."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:288
msgid "31"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:289
msgid "Auto Loop"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press this button to enter Auto Loop mode. Press the button again to enter a"
" second bank of auto loop lengths."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"To activate an auto loop, press a pad. To deactivate an auto loop, press the"
" pad again."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:294
msgid "32"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:295
msgid "Roll"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"Press this button to enter Roll Mode. Press the button again to enter a "
"second bank of roll lengths. To trigger a roll, press a pad."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid "{hwlabel}`SHIFT` + **Roll:** enter Sampler Mode."
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:300
msgid "33"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:301
msgid "Speakers"
msgstr ""

#: ../../hardware/controllers/numark_mixstream_pro.md:0
msgid ""
"These speakers will play the same current audio as the Main Outputs. Use the"
