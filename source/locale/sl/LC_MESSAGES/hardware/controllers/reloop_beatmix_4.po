msgstr ""

#: ../../hardware/controllers/reloop_beatmix_4.md:147
msgid "Turn left to disable effect 2"
msgstr ""

#: ../../hardware/controllers/reloop_beatmix_4.md:148
msgid "Effect parameter 2"
