msgid "Bass"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:83
msgid ""
"Adjusts the volume of a channels low frequency content (ex. bass drum)."
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:85
