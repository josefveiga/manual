msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:62
msgid "Play/Pause"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:63
msgid ""
"Starts playing a loaded track if stopped. If track is currently playing it "
"stops the track"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:64
#: ../../hardware/controllers/hercules_dj_console_rmx.md:135
msgid "Stop"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:65
msgid "Stops a currently playing track and moves to the beginning."
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:66
msgid "Cue"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:67
msgid ""
"Sets the cue point if a track is stopped and not at the current cue point. "
"Stops track and returns to the current cue point if a track is playing. "
"Plays preview if a track is stopped at the cue point for as long as it's "
"held down"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:68
msgid "Jog wheel"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:69
msgid ""
"Seeks forwards and backwards in a stopped track. Temporarily changes the "
"playback speed for playing tracks. Scratches both stopped and playing tracks"
" when scratch mode is on. Moves up / down in the tracklist if either Up or "
"Down is held down"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:70
#: ../../hardware/controllers/hercules_dj_console_rmx.md:137
msgid "Forward / Backward"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:71
msgid "Seeks at high speed in a track"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:72
msgid "Load Deck A/B"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:73
msgid ""
"Loads the currently selected track in the track list to the related deck"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:74
msgid "Cue Select"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:75
msgid "Toggles this decks output to the monitor (headphones) on and off"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:76
msgid "Pitch"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:77
msgid "Adjusts playback speed +/-10% (can be adjusted in the preferences)"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:78
msgid "Sync"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:79
msgid "Automatically sets pitch so the BPM of the other deck is matched"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:80
msgid "Pitch Reset"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:81
msgid "Resets the pitch to the tracks normal playback speed"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:82
