#: ../../hardware/controllers/hercules_dj_console_rmx.md:89
msgid "Adjusts flanger delay when Effect Shift is held down"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:90
#: ../../hardware/controllers/hercules_dj_console_rmx.md:143
msgid "Treble"
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:91
msgid "Adjusts the volume of a channels high frequency content (ex. hi-hats)."
msgstr ""

#: ../../hardware/controllers/hercules_dj_console_rmx.md:93
msgid "Adjusts flanger depth when Effect Shift is held down"
msgstr ""

